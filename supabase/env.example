# Copy to enclave/.env.supabase (git-ignored) and fill in. Never commit the filled-in file.
# Project settings > API in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key: public>
SUPABASE_SERVICE_ROLE_KEY=<service_role / secret key: SECRET, the underwriter's write key>
# Optional, for enclave/scripts/e2e-supabase.mjs:
# NOTCH_WEB3_URL=http://localhost:3000     # the site URL used in the sign-in message; allow it under Authentication > URL Configuration
# KEEPER_SHARED_SECRET=<same value as the keeper function secret and the Vault secret notch_keeper_secret>
