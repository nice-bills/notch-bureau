{
  "name": "notch-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "android:apk": "bash scripts/android-apk.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "demo:enclave": "node scripts/demo-enclave.mjs",
    "setup:devnet": "node scripts/devnet-setup.mjs",
    "e2e:devnet": "node scripts/e2e-devnet.mjs",
    "keeper": "node scripts/keeper.mjs",
    "e2e": "node scripts/e2e-browser.mjs",
    "e2e:browser:devnet": "playwright test -c e2e/playwright.config.ts --workers=1",
    "e2e:all": "pnpm --dir .. test && pnpm --dir .. test:enclave && pnpm --dir .. test:sdk && pnpm test && pnpm e2e:devnet && pnpm e2e"
  },
  "dependencies": {
    "@capacitor/android": "8.6.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.3",
    "@capacitor/local-notifications": "8.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@pollar/core": "0.12.0",
    "@reown/appkit": "1.8.24",
    "@solana-mobile/wallet-standard-mobile": "0.7.1",
    "@solana-program/system": "^0.14.1",
    "@solana-program/token": "^0.16.1",
    "@solana/kit": "^8.6.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@supabase/supabase-js": "^2.119.2",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "@wallet-standard/features": "^1.1.1",
    "@walletconnect/universal-provider": "2.23.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tweetnacl": "^1.0.3",
    "viem": "2.57.18"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3",
    "@playwright/test": "^1.65.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
